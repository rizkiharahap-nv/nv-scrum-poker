{
  "name": "nv-scrum-poker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Scrum Poker — Svelte 5 SPA + Node WebSocket server for Substrait (GKE).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.base.json --noEmit && tsc -p apps/server/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
