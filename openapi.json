{
  "openapi": "3.0.3",
  "info": {
    "title": "Scrum Hold'em Poker",
    "version": "1.0.0",
    "description": "Health and metadata. Realtime room protocol is WebSocket on /ws (not REST)."
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
